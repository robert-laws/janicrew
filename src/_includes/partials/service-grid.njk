<div class="grid grid--3">
  {% for a in janicrew.services.coreScope %}{% if a.tasks.length %}
  <article class="card card--link">
    <h3 class="card__title"><a href="/services/#{{ a.area | slugify }}">{{ a.area }}</a></h3>
    {% if a.rationale %}<p class="card__meta">{{ a.rationale }}</p>{% endif %}
    <p class="card__body">{{ a.tasks | joinTasks(" · ") }}</p>
    <span class="card__arrow" aria-hidden="true">See the checklist</span>
  </article>
  {% endif %}{% endfor %}
</div>
