{% set endpoint = site.formEndpoint %}
{% if not endpoint %}
<div class="form__notice mb-6" role="status">
  <p><strong>Draft mode.</strong> This form is not connected to a form service yet, so submitting it opens your email app with the details filled in. Or call <a href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>.</p>
</div>
{% endif %}
<form class="form quote-form" id="quote-form" method="POST"
      action="{{ endpoint if endpoint else 'mailto:' + site.email }}"{% if not endpoint %} enctype="text/plain"{% endif %}
      data-endpoint="{{ endpoint }}"
      data-thanks="{{ '/quote/thanks/' | htmlBaseUrl }}"
      data-email="{{ site.email }}">
  <input type="text" name="_gotcha" class="form__honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">
  <input type="hidden" name="_subject" value="New free quote request (JaniCrew website)">
  <input type="hidden" name="form_type" value="quote">

  <fieldset class="form__fieldset">
    <legend class="form__legend">What would you like?</legend>
    <div class="choice-grid choice-grid--2">
      <label class="choice choice--compact">
        <input type="radio" name="purpose" value="Quick quote" checked>
        <span class="choice__label">A quick quote</span>
        <p class="choice__hint">We call to book a short walkthrough and send a monthly estimate.</p>
      </label>
      <label class="choice choice--compact">
        <input type="radio" name="purpose" value="Company info">
        <span class="choice__label">Send me company info</span>
        <p class="choice__hint">Our services outline, no visit until you ask for one.</p>
      </label>
    </div>
  </fieldset>

  <fieldset class="form__fieldset">
    <legend class="form__legend">Areas to cover
      <span class="form__legend-hint">Tick every area you want in the scope. We list exactly what each one includes.</span>
    </legend>
    <div class="choice-grid choice-grid--2">
      {% for a in janicrew.services.coreScope %}{% if a.tasks.length %}
      <label class="choice">
        <input type="checkbox" name="areas[]" value="{{ a.area }}">
        <span class="choice__label">{{ a.area }}</span>
        <p class="choice__hint">{{ a.tasks | joinTasks(", ") }}</p>
      </label>
      {% endif %}{% endfor %}
    </div>
  </fieldset>

  <fieldset class="form__fieldset">
    <legend class="form__legend">Your industry</legend>
    <div class="choice-grid choice-grid--3">
      {% for i in industries %}
      <label class="choice choice--compact">
        <input type="radio" name="industry" value="{{ i.name }}" data-slug="{{ i.slug }}">
        <span class="choice__label">{{ i.name }}</span>
      </label>
      {% endfor %}
      <label class="choice choice--compact">
        <input type="radio" name="industry" value="Other" data-slug="other">
        <span class="choice__label">Other</span>
      </label>
    </div>
    <div class="form__grid mt-0" style="margin-top: var(--space-4)">
      <div class="field">
        <label class="field__label" for="industry_other">If other, tell us what kind of building <span class="field__optional">(optional)</span></label>
        <input class="input" type="text" id="industry_other" name="industry_other" autocomplete="off">
      </div>
      <div class="field">
        <label class="field__label" for="additional_specs">Regulations or special specifications <span class="field__optional">(optional)</span></label>
        <p class="field__hint" id="additional_specs-hint">Health codes, infection control, after-hours access, anything your industry requires.</p>
        <textarea class="textarea" id="additional_specs" name="additional_specs" aria-describedby="additional_specs-hint"></textarea>
      </div>
    </div>
  </fieldset>

  <fieldset class="form__fieldset">
    <legend class="form__legend">Additional services
      <span class="form__legend-hint">Beyond the regular scope. Optional.</span>
    </legend>
    <div class="choice-grid choice-grid--3">
      {% for s in janicrew.services.additional %}{% if s != "Other" %}
      <label class="choice choice--compact">
        <input type="checkbox" name="additional_services[]" value="{{ s }}">
        <span class="choice__label">{{ s }}</span>
      </label>
      {% endif %}{% endfor %}
    </div>
    <div class="field" style="margin-top: var(--space-4)">
      <label class="field__label" for="additional_other">Anything else? <span class="field__optional">(optional)</span></label>
      <input class="input" type="text" id="additional_other" name="additional_other">
    </div>
  </fieldset>

  <fieldset class="form__fieldset">
    <legend class="form__legend">How often?</legend>
    <div class="choice-grid choice-grid--3">
      {% for s in janicrew.services.schedules %}{% if s != "Other" %}
      <label class="choice choice--compact">
        <input type="radio" name="schedule" value="{{ s }}">
        <span class="choice__label">{{ s }}</span>
      </label>
      {% endif %}{% endfor %}
      <label class="choice choice--compact">
        <input type="radio" name="schedule" value="Other">
        <span class="choice__label">Something else</span>
      </label>
    </div>
    <div class="field" style="margin-top: var(--space-4)">
      <label class="field__label" for="schedule_other">Tell us the schedule you have in mind <span class="field__optional">(optional)</span></label>
      <input class="input" type="text" id="schedule_other" name="schedule_other" placeholder="e.g. three evenings a week">
    </div>
  </fieldset>

  <fieldset class="form__fieldset">
    <legend class="form__legend">Your building</legend>
    <div class="form__grid form__grid--2">
      <div class="field span-2">
        <label class="field__label" for="facility_address">Building address <span class="field__optional">(for the walkthrough)</span></label>
        <input class="input" type="text" id="facility_address" name="facility_address" autocomplete="street-address">
      </div>
      <div class="field">
        <label class="field__label" for="facility_size">Approximate size <span class="field__optional">(optional)</span></label>
        <input class="input" type="text" id="facility_size" name="facility_size" placeholder="e.g. 6,000 sq ft, 2 floors">
      </div>
      <div class="field">
        <label class="field__label" for="best_time">Best time to visit <span class="field__optional">(optional)</span></label>
        <input class="input" type="text" id="best_time" name="best_time" placeholder="e.g. weekday mornings">
      </div>
    </div>
  </fieldset>

  <fieldset class="form__fieldset">
    <legend class="form__legend">How do we reach you?</legend>
    <div class="form__grid form__grid--2">
      <div class="field">
        <label class="field__label" for="name">Your name</label>
        <input class="input" type="text" id="name" name="name" autocomplete="name" required>
      </div>
      <div class="field">
        <label class="field__label" for="company">Company or organisation</label>
        <input class="input" type="text" id="company" name="company" autocomplete="organization" required>
      </div>
      <div class="field">
        <label class="field__label" for="email">Email</label>
        <input class="input" type="email" id="email" name="email" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="phone">Phone <span class="field__optional">(optional)</span></label>
        <input class="input" type="tel" id="phone" name="phone" autocomplete="tel">
      </div>
      <div class="field span-2">
        <span class="field__label" id="preferred_contact-label">Preferred contact</span>
        <div class="choice-grid choice-grid--2" role="radiogroup" aria-labelledby="preferred_contact-label">
          <label class="choice choice--compact">
            <input type="radio" name="preferred_contact" value="Phone" checked>
            <span class="choice__label">Phone</span>
          </label>
          <label class="choice choice--compact">
            <input type="radio" name="preferred_contact" value="Email">
            <span class="choice__label">Email</span>
          </label>
        </div>
      </div>
      <div class="field span-2">
        <label class="field__label" for="notes">Notes <span class="field__optional">(optional)</span></label>
        <textarea class="textarea" id="notes" name="notes"></textarea>
      </div>
    </div>
  </fieldset>

  <div class="form__error" role="alert" hidden data-form-error>
    <p>Something went wrong sending the form. Please try again, or call <a href="{{ site.phoneHref }}">{{ site.phoneDisplay }}</a>.</p>
  </div>

  <div class="form__actions">
    <button class="btn btn--primary btn--lg" type="submit" data-submit>Request my free quote</button>
    <p>No obligation. We call to set up a 5-10 minute walkthrough.</p>
  </div>
</form>
